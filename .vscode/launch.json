{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Backend (FastAPI)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/app/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "args": [],
            "justMyCode": false,
            "stopOnEntry": false
        },
        {
            "name": "Debug Backend (uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host", "0.0.0.0",
                "--port", "8000",
                "--log-level", "debug"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/backend",
            "preLaunchTask": "Poetry Install",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend",
                "DEBUG": "true",
                "LOG_LEVEL": "DEBUG",
                "LOG_ENABLE_SEQ": "true",
                "SEQ_URL": "http://localhost:5341",
                "SEQ_API_KEY": "l6obaob16J6292tGOfnc",
                "DATABASE_HOST": "localhost",
                "DATABASE_PORT": "5432",
                "DATABASE_NAME": "eshop",
                "DATABASE_USER": "postgres",
                "DATABASE_PASSWORD": "postgres",
                "REDIS_HOST": "localhost",
                "REDIS_PORT": "6379",
                "RABBITMQ_HOST": "localhost",
                "RABBITMQ_PORT": "5672",
                "KEYCLOAK_SERVER_URL": "http://localhost:8080"
            },
            "justMyCode": false,
            "stopOnEntry": false,
            "subProcess": true,
            "python": "${command:python.interpreterPath}",
            "gevent": false
        },
        {
            "name": "Debug Backend (uvicorn with reload)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host", "0.0.0.0",
                "--port", "8000",
                "--reload",
                "--log-level", "debug"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/backend",
            "preLaunchTask": "Poetry Install",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend",
                "DEBUG": "true",
                "LOG_LEVEL": "DEBUG",
                "LOG_ENABLE_SEQ": "true",
                "SEQ_URL": "http://localhost:5341",
                "SEQ_API_KEY": "l6obaob16J6292tGOfnc",
                "DATABASE_HOST": "localhost",
                "DATABASE_PORT": "5432",
                "DATABASE_NAME": "eshop",
                "DATABASE_USER": "postgres",
                "DATABASE_PASSWORD": "postgres",
                "REDIS_HOST": "localhost",
                "REDIS_PORT": "6379",
                "RABBITMQ_HOST": "localhost",
                "RABBITMQ_PORT": "5672",
                "KEYCLOAK_SERVER_URL": "http://localhost:8080"
            },
            "justMyCode": false,
            "stopOnEntry": false,
            "subProcess": true,
            "python": "${command:python.interpreterPath}",
            "gevent": false,
            "note": "Note: Breakpoints in async event handlers may not work with --reload. Use 'Debug Backend (uvicorn)' without reload for debugging event handlers."
        },
        {
            "name": "Debug Frontend (HTTP Server)",
            "type": "debugpy",
            "request": "launch",
            "module": "http.server",
            "args": ["3000"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/frontend",
            "envFile": "${workspaceFolder}/.env",
            "serverReadyAction": {
                "pattern": "Serving HTTP on.*port 3000",
                "uriFormat": "http://localhost:3000",
                "action": "debugWithChrome"
            }
        },
        {
            "name": "Debug Frontend (Chrome)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMaps": true,
            "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile"
        },
        {
            "name": "Debug Frontend (Edge)",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMaps": true,
            "userDataDir": "${workspaceFolder}/.vscode/edge-debug-profile"
        },
        {
            "name": "Debug Backend Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "--tb=short",
                "--cov=app",
                "--cov-report=term-missing"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend",
                "TESTING": "true"
            },
            "justMyCode": false
        }
    ],
    "compounds": [
        {
            "name": "Debug Full Stack (Backend + Frontend)",
            "configurations": [
                "Debug Backend (uvicorn)",
                "Debug Frontend (HTTP Server)"
            ],
            "stopAll": true
        },
        {
            "name": "Debug Backend + Tests",
            "configurations": [
                "Debug Backend (uvicorn)",
                "Debug Backend Tests"
            ],
            "stopAll": true
        },
        {
            "name": "Stop All Debug Sessions",
            "configurations": [],
            "stopAll": true
        }
    ]
}