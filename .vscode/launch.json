{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Debug Backend (FastAPI)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/backend/app/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "args": [],
            "justMyCode": false,
            "stopOnEntry": false
        },
        {
            "name": "Debug Backend (uvicorn)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host", "0.0.0.0",
                "--port", "8000",
                "--reload",
                "--log-level", "debug"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "justMyCode": false,
            "stopOnEntry": false
        },
        {
            "name": "Debug Frontend (HTTP Server)",
            "type": "python",
            "request": "launch",
            "module": "http.server",
            "args": ["3000"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/frontend",
            "serverReadyAction": {
                "pattern": "Serving HTTP on.*port 3000",
                "uriFormat": "http://localhost:3000",
                "action": "debugWithChrome"
            }
        },
        {
            "name": "Debug Frontend (Chrome)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMaps": true,
            "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile"
        },
        {
            "name": "Debug Frontend (Edge)",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMaps": true,
            "userDataDir": "${workspaceFolder}/.vscode/edge-debug-profile"
        },
        {
            "name": "Debug Backend Tests",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "--tb=short",
                "--cov=app",
                "--cov-report=term-missing"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "justMyCode": false
        },

    ],
    "compounds": [
        {
            "name": "Debug Full Stack (Backend + Frontend)",
            "configurations": [
                "Debug Backend (uvicorn)",
                "Debug Frontend (HTTP Server)"
            ],
            "stopAll": true
        },
        {
            "name": "Debug Backend + Tests",
            "configurations": [
                "Debug Backend (uvicorn)",
                "Debug Backend Tests"
            ],
            "stopAll": true
        },
        {
            "name": "Stop All Debug Sessions",
            "configurations": [],
            "stopAll": true
        }
    ]
} 