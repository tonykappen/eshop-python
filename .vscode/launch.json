{
    // VS Code Debug Configurations for eShop Application
    // 
    // Environment Variables Priority (highest to lowest):
    // 1. os.environ (system/production environment variables) - HIGHEST
    // 2. .env file (local development configuration)
    // 3. launch.json "env" values (IDE debugging convenience) - LOWEST
    // 4. settings.py defaults (fallback)
    //
    // This priority order follows 12-Factor App methodology and ensures:
    // - Production safety: System env vars always take precedence
    // - Docker/Kubernetes compatibility: Container env vars win
    // - Developer convenience: .env provides local defaults
    // - IDE flexibility: launch.json provides debug overrides (but can't override production)
    //
    // Quick Start:
    // 1. Copy env.example to .env: cp env.example .env
    // 2. Start infrastructure: ./scripts/start-infrastructure.sh
    // 3. Press F5 or select a debug configuration below
    //
    // See ENVIRONMENT_VARIABLES.md for detailed documentation
    
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Debug Backend (FastAPI)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/app/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "args": [],
            "justMyCode": false,
            "stopOnEntry": false
        },
        {
            "name": "Debug Backend (uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host", "0.0.0.0",
                "--port", "8000",
                "--reload",
                "--log-level", "debug"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend",
                "DEBUG": "true",
                "LOG_LEVEL": "DEBUG",
                "LOG_ENABLE_SEQ": "true",
                "SEQ_URL": "http://localhost:5341",
                "SEQ_API_KEY": "l6obaob16J6292tGOfnc",
                "DATABASE_HOST": "localhost",
                "DATABASE_PORT": "5432",
                "DATABASE_NAME": "eshop",
                "DATABASE_USER": "postgres",
                "DATABASE_PASSWORD": "postgres",
                "REDIS_HOST": "localhost",
                "REDIS_PORT": "6379",
                "RABBITMQ_HOST": "localhost",
                "RABBITMQ_PORT": "5672",
                "KEYCLOAK_SERVER_URL": "http://localhost:8080"
            },
            "justMyCode": false,
            "stopOnEntry": false
        },
        {
            "name": "Debug Frontend (HTTP Server)",
            "type": "debugpy",
            "request": "launch",
            "module": "http.server",
            "args": ["3000"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/frontend",
            "serverReadyAction": {
                "pattern": "Serving HTTP on.*port 3000",
                "uriFormat": "http://localhost:3000",
                "action": "debugWithChrome"
            }
        },
        {
            "name": "Debug Frontend (Chrome)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMaps": true,
            "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile"
        },
        {
            "name": "Debug Frontend (Edge)",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMaps": true,
            "userDataDir": "${workspaceFolder}/.vscode/edge-debug-profile"
        },
        {
            "name": "Debug Backend Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "--tb=short",
                "--cov=app",
                "--cov-report=term-missing"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend",
                "TESTING": "true"
            },
            "justMyCode": false
        },

    ],
    "compounds": [
        {
            "name": "Debug Full Stack (Backend + Frontend)",
            "configurations": [
                "Debug Backend (uvicorn)",
                "Debug Frontend (HTTP Server)"
            ],
            "stopAll": true
        },
        {
            "name": "Debug Backend + Tests",
            "configurations": [
                "Debug Backend (uvicorn)",
                "Debug Backend Tests"
            ],
            "stopAll": true
        },
        {
            "name": "Stop All Debug Sessions",
            "configurations": [],
            "stopAll": true
        }
    ]
} 