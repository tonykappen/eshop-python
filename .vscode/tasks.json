{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Stop All Development Servers",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/stop-servers.sh",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Stop Backend Server",
            "type": "shell",
            "command": "pkill",
            "args": ["-f", "uvicorn"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Start Frontend Server",
            "type": "shell",
            "command": "python3",
            "args": ["-m", "http.server", "3000"],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "Stop Frontend Server",
            "type": "shell",
            "command": "pkill",
            "args": ["-f", "python3.*http.server.*3000"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Check Running Servers",
            "type": "shell",
            "command": "ps",
            "args": ["aux"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Poetry Lock",
            "type": "shell",
            "command": "poetry",
            "args": ["lock", "--no-interaction"],
            "options": {
                "cwd": "${workspaceFolder}/backend",
                "env": {
                    "POETRY_PYTHON": "${config:python.defaultInterpreterPath}"
                }
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Poetry Install",
            "type": "shell",
            "command": "poetry",
            "args": ["install", "--no-interaction"],
            "options": {
                "cwd": "${workspaceFolder}/backend",
                "env": {
                    "POETRY_PYTHON": "${config:python.defaultInterpreterPath}"
                }
            },
            "dependsOn": "Poetry Lock",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Setup Frontend Test Prerequisites",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/setup-frontend-tests.sh",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Backend Tests",
            "type": "shell",
            "command": "poetry",
            "args": ["run", "pytest", "app/tests/"],
            "options": {
                "cwd": "${workspaceFolder}/backend",
                "env": {
                    "POETRY_PYTHON": "${config:python.defaultInterpreterPath}"
                }
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Frontend Unit Tests",
            "type": "shell",
            "command": "npm",
            "args": ["test"],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Frontend API Contract Tests",
            "type": "shell",
            "command": "npm",
            "args": ["run", "test:api-contracts"],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Frontend E2E Tests",
            "type": "shell",
            "command": "npm",
            "args": ["run", "test:e2e"],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run All Tests",
            "dependsOn": [
                "Run Backend Tests",
                "Run Frontend Unit Tests",
                "Run Frontend API Contract Tests",
                "Run Frontend E2E Tests"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
