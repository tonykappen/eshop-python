							"script": {
								"type": "text/javascript",
								"exec": [
									"const currentUser = pm.collectionVariables.get('current_user');",
									"console.log('🔍 Testing product update for user: ' + currentUser);",
									"",
									"if (pm.response.code === 200) {",
									"    console.log('✅ Product update successful for ' + currentUser);",
									"    const responseData = pm.response.json();",
									"    if (responseData.success !== undefined) {",
									"        console.log('✅ Update success: ' + responseData.success);",
									"    }",
									"} else if (pm.response.code === 401) {",
									"    console.log('❌ Unauthorized access for ' + currentUser);",
									"} else if (pm.response.code === 403) {",
									"    console.log('🚫 Forbidden: ' + currentUser + ' cannot update products (User role only)');",
									"} else if (pm.response.code === 404) {",
