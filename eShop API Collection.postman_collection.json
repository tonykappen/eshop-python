    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get Bearer Token (TestUser)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const tokenData = pm.response.json();",
                  "    pm.collectionVariables.set('bearer_token', tokenData.access_token);",
                  "    pm.collectionVariables.set('token_timestamp', Date.now().toString());",
                  "    pm.collectionVariables.set('token_expires_in', tokenData.expires_in.toString());",
                  "    pm.collectionVariables.set('current_user', 'testuser');",
                  "    console.log('✅ TestUser token stored successfully');",
                  "    console.log('🔑 Token: ' + tokenData.access_token.substring(0, 50) + '...');",
                  "} else {",
                  "    console.error('❌ Failed to get TestUser token:', pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "testuser"
                },
                {
                  "key": "password",
                  "value": "changeme123"
                },
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}"
                }
              ]
            },
            "url": {
