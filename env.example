# Application Settings
APP_NAME=eShop Modular Monolith
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Service Metadata (for CLEF logging)
SERVICE_NAME=eshop-api
SERVICE_VERSION=1.0.0

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eshop
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Keycloak
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=eshop
KEYCLOAK_CLIENT_ID=eshop-api
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak Credentials File
# Path to the YAML file containing Keycloak credentials (realms, clients, users, roles)
# If not specified, searches: infra/keycloak/credentials.yaml (recommended), keycloak_credentials.yaml (legacy)
KEYCLOAK_CREDENTIALS_PATH=infra/keycloak/credentials.yaml

# Keycloak Provisioning
# If true, automatically provision realms/clients/users/roles on startup
# Recommended: false for production, true for development/testing
KEYCLOAK_AUTO_PROVISION=false

# Logging
LOG_LEVEL=INFO
SEQ_URL=http://localhost:5341
SEQ_API_KEY=your-seq-api-key-change-in-production
LOG_ENABLE_CONSOLE=true
LOG_ENABLE_SEQ=true
LOG_ENABLE_FILE=true
LOG_DIRECTORY=run_time/logs
LOG_SEPARATE_SERVER_LOGS=true
LOG_ENABLE_REQUEST_LOGGING=true
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false 