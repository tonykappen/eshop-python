#!/bin/bash
log_dir="$HOME/.git-push-logs"
mkdir -p "$log_dir"

allowed_org_regex='^(git@|https://)github\.com[:/]([fF]resh|fw|ayanr|airwoot|digital-cx|lighthouse-fws|RPA-Testing|sarastech)[^/]*/.*$'
webhook_url="https://ghc.freshpo.com/ghctest"

remote_url=$(git remote get-url origin 2>/dev/null)
user_email=$(git config user.email)
user_name=$(git config user.name)
repo_path=$(pwd)
timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
log_file="$log_dir/webhook_debug_$(date +%Y%m%d_%H%M%S).log"

if [[ ! "$remote_url" =~ $allowed_org_regex ]]; then
  log_line="$timestamp :: $user_name <$user_email> tried to push to DISALLOWED remote: $remote_url in $repo_path"
  echo "$log_line" >> "$log_dir/violations.log"

  echo "❌ Push blocked: Unauthorized remote → $remote_url"
  echo "� Only approved GitHub organizations are allowed."
  echo "To disable this hook:"
  echo "    rm -f .git/hooks/pre-push"

  payload=$(printf '{
    "alert_type": "GIT_PUSH_POLICY_VIOLATION",
    "timestamp": "%s",
    "user": {
      "name": "%s",
      "email": "%s"
    },
    "repository": "%s",
    "remote_url": "%s"
  }' "$timestamp" "$user_name" "$user_email" "$repo_path" "$remote_url")

  echo "� Payload:" >> "$log_file"
  echo "$payload" >> "$log_file"

  echo "� Sending to webhook: $webhook_url" >> "$log_file"
  curl_response=$(curl -s -w "\nHTTP_STATUS=%{http_code}" -o - -X POST -H "Content-Type: application/json" -d "$payload" "$webhook_url")
  echo "$curl_response" >> "$log_file"

  exit 1
fi

exit 0
