# Keycloak Credentials Configuration
# Copy this file to keycloak_credentials.yaml and update with your actual credentials
# DO NOT commit keycloak_credentials.yaml to version control

# Master Admin Credentials (for initial realm setup)
# These are the credentials for the Keycloak master realm admin
master_admin:
  username: admin
  password: admin

# Realm Admin Credentials
# This user will be created with admin privileges in your application realm
realm_admin:
  username: realm-admin
  email: realm-admin@eshop.com
  password: admin123
  first_name: Realm
  last_name: Admin

# Application Clients
# Define the OAuth/OIDC clients for your application
clients:
  - client_id: eshop-api
    client_secret: your-secure-client-secret-here
    redirect_uris:
      - "http://localhost:8000/*"
      - "https://yourdomain.com/*"
    web_origins:
      - "http://localhost:8000"
      - "https://yourdomain.com"
    service_accounts_enabled: true
    authorization_services_enabled: true
    direct_access_grants_enabled: true
    standard_flow_enabled: true

# RBAC Roles
# Define the roles for your application
roles:
  - name: user
    description: "Basic user role - can read data"
  - name: manager
    description: "Manager role - can read and write data"
  - name: admin
    description: "Admin role - full access to all operations"

# Application Users
# Define test/initial users for your application
users:
  - username: adminuser
    email: admin@example.com
    password: changeme123
    first_name: Admin
    last_name: User
    roles:
      - admin
    email_verified: true
    enabled: true

  - username: manager
    email: manager@example.com
    password: changeme123
    first_name: Manager
    last_name: User
    roles:
      - manager
    email_verified: true
    enabled: true

  - username: testuser
    email: testuser@example.com
    password: changeme123
    first_name: Test
    last_name: User
    roles:
      - user
    email_verified: true
    enabled: true

# Role Hierarchy Configuration
# Define composite roles (roles that include other roles)
role_hierarchy:
  admin:
    includes:
      - manager
      - user
  manager:
    includes:
      - user

