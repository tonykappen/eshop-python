	"event": [
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// User configuration - define available users and their credentials",
					"const users = {",
					"    'user': { username: 'user', password: 'password', role: 'User (Read-only)' },",
					"    'testuser': { username: 'testuser', password: 'password', role: 'User (Read-only)' },",
					"    'manager': { username: 'manager', password: 'password', role: 'Manager (Read/Write)' },",
					"    'adminuser': { username: 'adminuser', password: 'password', role: 'Admin (Full Access)' }",
					"};",
					"",
					"// Get current user selection",
					"const currentUser = pm.collectionVariables.get('current_user');",
					"const userCreds = users[currentUser] || users['user'];",
					"",
					"// Handle 401 responses by refreshing token and retrying",
					"if (pm.response.code === 401) {",
					"    console.log('🔄 Token expired for ' + currentUser + ', refreshing...');",
					"    ",
					"    // Clear the expired token",
					"    pm.collectionVariables.set('bearer_token', '');",
					"    pm.collectionVariables.set('token_timestamp', '');",
					"    ",
					"    // Get a new token",
					"    const tokenRequest = {",
					"        url: pm.collectionVariables.get('keycloak_url') + '/realms/' + pm.collectionVariables.get('realm') + '/protocol/openid-connect/token',",
					"        method: 'POST',",
					"        header: {",
					"            'Content-Type': 'application/x-www-form-urlencoded'",
					"        },",
					"        body: {",
					"            mode: 'urlencoded',",
					"            urlencoded: [",
					"                { key: 'username', value: userCreds.username },",
					"                { key: 'password', value: userCreds.password },",
					"                { key: 'grant_type', value: 'password' },",
					"                { key: 'client_id', value: pm.collectionVariables.get('client_id') }",
					"                { key: 'client_secret', value: pm.collectionVariables.get('client_secret') }",
					"            ]",
					"        }",
					"    };",
					"    ",
					"    pm.sendRequest(tokenRequest, function (err, response) {",
					"        if (response.code === 200) {",
					"            const tokenData = response.json();",
					"            pm.collectionVariables.set('bearer_token', tokenData.access_token);",
					"            pm.collectionVariables.set('token_timestamp', Date.now().toString());",
					"            pm.collectionVariables.set('token_expires_in', tokenData.expires_in.toString());",
					"            console.log('✅ Token refreshed successfully for ' + currentUser);",
					"            console.log('🔄 Please retry the request manually with the new token');",
					"        } else {",
					"            console.error('❌ Failed to refresh token for ' + currentUser + ':', response.text());",
					"        }",
					"    });",
					"}"
				]
			}
		}
	]
