					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const currentUser = pm.collectionVariables.get('current_user');",
									"console.log('Testing product creation for user: ' + currentUser);",
									"",
									"if (pm.response.code === 201 || pm.response.code === 200) {",
									"    console.log('✅ Product creation successful for ' + currentUser);",
									"} else if (pm.response.code === 401) {",
									"    console.log('❌ Unauthorized access for ' + currentUser);",
									"} else if (pm.response.code === 403) {",
									"    console.log('🚫 Forbidden: ' + currentUser + ' cannot create products (User role only)');",
									"} else {",
									"    console.log('⚠️ Unexpected response: ' + pm.response.code);",
									"}"
								]
							}
						}
