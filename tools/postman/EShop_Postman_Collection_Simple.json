		{
			"name": "RBAC Testing",
			"item": [
				{
					"name": "Test User Access (Read-only)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const currentUser = pm.collectionVariables.get('current_user');",
									"console.log('Testing RBAC for user: ' + currentUser);",
									"",
									"if (pm.response.code === 200) {",
									"    console.log('✅ Access granted for ' + currentUser);",
									"    const responseData = pm.response.json();",
									"    if (responseData.data) {",
									"        console.log('📊 Products returned: ' + responseData.data.length);",
									"    }",
									"} else if (pm.response.code === 401) {",
									"    console.log('❌ Unauthorized access for ' + currentUser);",
									"} else if (pm.response.code === 403) {",
									"    console.log('🚫 Forbidden access for ' + currentUser + ' (insufficient permissions)');",
									"} else {",
									"    console.log('⚠️ Unexpected response: ' + pm.response.code);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
