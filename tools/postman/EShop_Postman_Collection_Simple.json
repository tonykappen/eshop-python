	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Simple user configuration",
					"var users = {",
					"    'user': { username: 'user', password: 'password' },",
					"    'testuser': { username: 'testuser', password: 'password' },",
					"    'manager': { username: 'manager', password: 'password' },",
					"    'adminuser': { username: 'adminuser', password: 'password' }",
					"};",
					"",
					"// Get current user",
					"var currentUser = pm.collectionVariables.get('current_user');",
					"var userCreds = users[currentUser];",
					"",
					"if (!userCreds) {",
					"    console.error('Invalid user: ' + currentUser);",
					"    return;",
					"}",
					"",
					"console.log('Using user: ' + currentUser);",
					"",
					"// Get token",
					"var tokenRequest = {",
					"    url: pm.collectionVariables.get('keycloak_url') + '/realms/' + pm.collectionVariables.get('realm') + '/protocol/openid-connect/token',",
					"    method: 'POST',",
					"    header: {",
					"        'Content-Type': 'application/x-www-form-urlencoded'",
					"    },",
					"    body: {",
					"        mode: 'urlencoded',",
					"        urlencoded: [",
					"            { key: 'username', value: userCreds.username },",
					"            { key: 'password', value: userCreds.password },",
					"            { key: 'grant_type', value: 'password' },",
					"            { key: 'client_id', value: pm.collectionVariables.get('client_id') },",
					"            { key: 'client_secret', value: pm.collectionVariables.get('client_secret') }",
					"        ]",
					"    }",
					"};",
					"",
					"pm.sendRequest(tokenRequest, function (err, response) {",
					"    if (err) {",
					"        console.error('Error:', err);",
					"        return;",
					"    }",
					"    ",
					"    if (response.code === 200) {",
					"        var tokenData = response.json();",
					"        pm.collectionVariables.set('bearer_token', tokenData.access_token);",
					"        console.log('Token generated for ' + currentUser);",
					"    } else {",
					"        console.error('Failed to get token:', response.text());",
					"    }",
					"});"
				]
			}
		}
	],
